{
  "expo": {
    "name": "Transalp Bordcomputer",
    "slug": "transalp-bordcomputer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "transalp-bordcomputer",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.titoprausee.transalp-bordcomputer",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Die App benoetigt Bluetooth, um sich mit dem Bordcomputer zu verbinden.",
        "NSBluetoothPeripheralUsageDescription": "Die App benoetigt Bluetooth, um sich mit dem Bordcomputer zu verbinden.",
        "NSLocationWhenInUseUsageDescription": "Die App nutzt die Position fuer Navigation und Wetterdaten."
      }
    },
    "android": {
      "package": "com.titoprausee.transalpbordcomputer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0c"
      },
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "transalp-bordcomputer"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/transalp-bordcomputer"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
