# Build-Konfiguration für ESP-IDF
# Flash-Size
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# FreeRTOS Tick Rate (1000Hz für präzise Timings)
CONFIG_FREERTOS_HZ=1000
# FreeRTOS Trace Facility (for uxTaskGetSystemState in diagnostics)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# Bluetooth — NimBLE (smaller footprint than Bluedroid)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CCCDS=8
CONFIG_BT_NIMBLE_50_FEATURES_SUPPORTED=y
CONFIG_BT_NIMBLE_EXT_ADV=n
# BLE Privacy — Resolvable Private Address (RPA). The ESP32-S3 controller
# generates RPAs from the device IRK registered at runtime (see
# components/ble_privacy/). This rotates the on-air address every RPA_TIMEOUT
# seconds so a static address can no longer be used to track the device across
# sessions. Bonded peers resolve the RPA via the IRK distributed during pairing.
# TOT-64.
CONFIG_BT_NIMBLE_RPA_TIMEOUT=900
# FAT FS für SD-Karte
CONFIG_FATFS_CODEPAGE_850=y
CONFIG_FATFS_LFN_STACK=y
# Log-Level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Partition Scheme (OTA-fähig)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
# OTA Support
CONFIG_APP_ROLLBACK_ENABLE=y
# HTTP Client (for OTA-From-URL)
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# mbedTLS (for SHA256 + RSA verification)
CONFIG_MBEDTLS_RSA_LARGE_KEY=y
CONFIG_MBEDTLS_RSA_C=y
# --- Secure Boot V2 (production) ---
# Signs firmware images at build time with RSA-3072.
# The bootloader verifies signatures using the eFuse-embedded key digest.
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot/ota_signing_key.pem"
# --- Flash Encryption (production) ---
# Encrypts flash contents; bootloader decrypts at runtime.
CONFIG_SECURE_FLASH_ENC_ENABLED=y
# --- Anti-Rollback (eFuse SECURE_VERSION) ---
# Bootloader rejects firmware with a version below the eFuse counter.
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_BOOTLOADER_APP_SEC_VER_SIZE_EFUSE_FIELD=32
CONFIG_BOOTLOADER_APP_SEC_VER=1
