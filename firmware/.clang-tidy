# clang-tidy strict configuration — TOT-58 firmware hardening
# Strict checks for embedded C (ESP-IDF). Value-flow/whole-program checks
# that require a full idf.py build are not enabled here; see the audit report.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  hicpp-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -bugprone-signed-bitwise,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -hicpp-no-array-decay,
  -hicpp-vararg,
  -hicpp-signed-bitwise,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-use-internal-linkage,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-use-default-member-init,
  -modernize-avoid-c-style-cast,
  -cppcoreguidelines-macro-to-enum,
  -modernize-macro-to-enum,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-else-after-return,
  -readability-implicit-bool-conversion,
  -readability-isolate-declaration,
  -readability-nonconst-parameter,
  -readability-redundant-access-specifiers,
  -readability-convert-member-functions-to-static,
  -readability-uppercase-literal-suffix,
  -readability-math-missing-parentheses,
  -readability-suspicious-call-argument,
  -readability-named-parameter,
  -readability-inconsistent-declaration-parameter-name,
  -readability-braces-around-statements,
  -readability-redundant-casting,
  -readability-trailing-comma,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-avoid-nested-conditional-operator,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-narrowing-conversions,
  -cert-err34-c,
  -cert-err33-c,
  -cert-err58-cpp,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -clang-analyzer-optin.mpi,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-unix.Malloc,
  -clang-analyzer-unix.Vfork,
  -clang-analyzer-valist.Uninitialized,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -performance-no-int-to-ptr,
WarningsAsErrors: ''
HeaderFilterRegex: 'components/.*|main/.*'
FormatStyle: none
CheckOptions:
  - key:   readability-braces-around-statements.ShortStatementLines
    value: '2'
  - key:   readability-function-cognitive-complexity.Threshold
    value: '40'
